{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/feedback/**",
              "components/forms/**",
              "components/navigation/**",
              "components/surfaces/**",
              "components/tracking/**",
              "ui_kits/wayix-app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Inter|Poppins))/i]",
        "message": "Font not provided by the design system. Available: Inter, Poppins."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|iconLeft|iconRight|loading|fullWidth|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, iconLeft, iconRight, loading, fullWidth."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:elevated|glow|padding|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: elevated, glow, padding."
      },
      {
        "selector": "JSXOpeningElement[name.name='Checkpoint'] > JSXAttribute > JSXIdentifier[name!=/^(?:index|label|reached|finish|size|key|ref|className|style|children)$/]",
        "message": "<Checkpoint> doesn't accept that prop. Declared props: index, label, reached, finish, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='ConnectionCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:status|connected|key|ref|className|style|children)$/]",
        "message": "<ConnectionCard> doesn't accept that prop. Declared props: status, connected."
      },
      {
        "selector": "JSXOpeningElement[name.name='GroupMap'] > JSXAttribute > JSXIdentifier[name!=/^(?:riders|checkpoints|route|height|round|key|ref|className|style|children)$/]",
        "message": "<GroupMap> doesn't accept that prop. Declared props: riders, checkpoints, route, height, round."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|color|strokeWidth|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, color, strokeWidth."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|iconSize|variant|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: name, size, iconSize, variant."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:surface|surface-4|accent)$/]",
        "message": "<IconButton> variant must be one of 'surface' | 'surface-4' | 'accent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|placeholder|onChange|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: value, placeholder, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavInfoCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|metric|descriptor|progress|key|ref|className|style|children)$/]",
        "message": "<NavInfoCard> doesn't accept that prop. Declared props: icon, metric, descriptor, progress."
      },
      {
        "selector": "JSXOpeningElement[name.name='RiderListRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|role|initials|distance|status|you|key|ref|className|style|children)$/]",
        "message": "<RiderListRow> doesn't accept that prop. Declared props: name, role, initials, distance, status, you."
      },
      {
        "selector": "JSXOpeningElement[name.name='RiderListRow'] > JSXAttribute[name.name='role'] > Literal[value!=/^(?:lead|sweep|member)$/]",
        "message": "<RiderListRow> role must be one of 'lead' | 'sweep' | 'member'."
      },
      {
        "selector": "JSXOpeningElement[name.name='RiderMarker'] > JSXAttribute > JSXIdentifier[name!=/^(?:role|label|initials|heading|you|size|key|ref|className|style|children)$/]",
        "message": "<RiderMarker> doesn't accept that prop. Declared props: role, label, initials, heading, you, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='RiderMarker'] > JSXAttribute[name.name='role'] > Literal[value!=/^(?:lead|sweep|member)$/]",
        "message": "<RiderMarker> role must be one of 'lead' | 'sweep' | 'member'."
      },
      {
        "selector": "JSXOpeningElement[name.name='RoleBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:role|key|ref|className|style|children)$/]",
        "message": "<RoleBadge> doesn't accept that prop. Declared props: role."
      },
      {
        "selector": "JSXOpeningElement[name.name='RoleBadge'] > JSXAttribute[name.name='role'] > Literal[value!=/^(?:lead|sweep|member)$/]",
        "message": "<RoleBadge> role must be one of 'lead' | 'sweep' | 'member'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SegmentedControl'] > JSXAttribute > JSXIdentifier[name!=/^(?:options|value|onChange|key|ref|className|style|children)$/]",
        "message": "<SegmentedControl> doesn't accept that prop. Declared props: options, value, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='Stepper'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|display|min|max|step|onChange|key|ref|className|style|children)$/]",
        "message": "<Stepper> doesn't accept that prop. Declared props: value, display, min, max, step, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='TransportBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:startLabel|endLabel|progress|playing|onToggle|onPrev|onNext|key|ref|className|style|children)$/]",
        "message": "<TransportBar> doesn't accept that prop. Declared props: startLabel, endLabel, progress, playing, onToggle, onPrev, onNext."
      },
      {
        "selector": "JSXOpeningElement[name.name='TurnRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|distance|street|key|ref|className|style|children)$/]",
        "message": "<TurnRow> doesn't accept that prop. Declared props: icon, distance, street."
      },
      {
        "selector": "JSXOpeningElement[name.name='VoiceBlob'] > JSXAttribute > JSXIdentifier[name!=/^(?:state|size|key|ref|className|style|children)$/]",
        "message": "<VoiceBlob> doesn't accept that prop. Declared props: state, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='VoiceBlob'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:idle|listening|speaking)$/]",
        "message": "<VoiceBlob> state must be one of 'idle' | 'listening' | 'speaking'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
